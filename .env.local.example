# Copia este archivo a .env.local y completa los valores.
#
# --- Dominios (lib/site.ts) -------------------------------------------------
# Los tres dominios del proyecto. Ningún dominio está escrito a mano en el
# código: cambiar estas variables es lo que mueve el sitio de un host a otro.
# Ver CUTOVER.md.

# Dónde vive ESTE frontend. Se usa en canónicas, sitemap y enlaces de correo.
# En staging: la URL del preview de Vercel.
NEXT_PUBLIC_SITE_URL=https://lafab.com.co

# Backend WooCommerce. Hoy staging; en el cutover pasa a cms.lafab.com.co.
# OJO: no puede apuntar al mismo dominio que el frontend o se llama a sí mismo.
NEXT_PUBLIC_WC_STORE_URL=https://staging.lafab.com.co

# De dónde se sirven las imágenes (/wp-content/*). Si se omite, usa el backend.
# Cuando los medios se muevan a un CDN, se cambia solo esta línea.
NEXT_PUBLIC_WP_MEDIA_URL=

# Interruptor del cutover: abre robots.txt, quita el <meta noindex> y enciende
# la analítica (GA, Pixel, Clarity). Dejar apagado hasta el día del cambio.
NEXT_PUBLIC_ALLOW_INDEX=false

# --- Correo (Resend) --------------------------------------------------------
# API key del proyecto en Resend. Sin ella no se envía nada (se registra y sigue).
RESEND_API_KEY=
# Remitente verificado en Resend, con SPF/DKIM del dominio.
MAIL_FROM=LaFab <hola@lafab.com.co>
# Opcional: a dónde responde el cliente.
MAIL_REPLY_TO=
# '1' para no enviar de verdad (útil en preview).
MAIL_DRY_RUN=

# --- Disparadores de los correos de pedido ----------------------------------
# Secreto del webhook de WooCommerce (WooCommerce → Ajustes → Avanzado → Webhooks).
# Debe ser idéntico al configurado allá o las entregas se rechazan con 401.
WC_WEBHOOK_SECRET=
# Opcional: sobrescribe el mapa estado→plantilla. JSON, se fusiona con el de por
# defecto. Útil si el taller usa slugs propios, p.ej.:
#   {"wc-taller":"en-produccion","despachado":"va-en-camino"}
WC_STATUS_EMAILS=
# Estados que significan "ya lo tiene en casa" y disparan cuidado + reseña.
WC_DELIVERED_STATUSES=completed,entregado,delivered
# Esperas de los correos diferidos, en horas.
WELCOME_DELAY_HOURS=24
CARE_DELAY_HOURS=48
REVIEW_DELAY_HOURS=240
# Enlace de reseña; por defecto usa el de Google que ya está en lib/content.ts.
REVIEW_URL=
# Token del endpoint manual /api/emails/send (cotización y pruebas de envío).
EMAILS_ADMIN_TOKEN=

# --- Carrito abandonado -----------------------------------------------------
# Vercel las inyecta al conectar un store KV/Upstash al proyecto.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Sal para derivar el id del carrito desde el correo. Cadena larga y aleatoria.
CART_ID_SECRET=
# Secreto del cron: Vercel lo envía como 'Authorization: Bearer <CRON_SECRET>'.
CRON_SECRET=
# Horas de espera antes del recordatorio (def. 5) y edad máxima (def. 72).
ABANDONED_CART_DELAY_HOURS=5
ABANDONED_CART_MAX_AGE_HOURS=72
# Tope de correos por ejecución; 0 apaga el envío sin tocar código.
ABANDONED_CART_MAX_PER_RUN=50
# Tope de correos diferidos por ejecución del cron.
MAIL_QUEUE_MAX_PER_RUN=50

# Logo de los correos. Si se omite, se toma de NEXT_PUBLIC_WP_MEDIA_URL.
# Gmail no siempre proxea el logo desde WordPress: un CDN lo resuelve.
MAIL_LOGO_URL=
